https://kelee.one/Tool/Loon/Lsr/AI.lsr, policy=美国场景, tag=AI, enabled=true
https://kelee.one/Tool/Loon/Lsr/SpeedtestInternational.lsr, policy=全球场景, tag=Speedtest Intl, enabled=true
https://rule.kelee.one/Loon/Netflix.lsr, policy=新国场景, tag=Netflix, enabled=true
https://raw.githubusercontent.com/ipiggyzhu/rules/refs/heads/main/Loon/direct-rules.list, policy=DIRECT, tag=direct-rules, enabled=true
https://kelee.one/Tool/Loon/Lsr/REGION_SPLITTER.lsr, policy=DIRECT, tag=CN REGION, enabled=true

